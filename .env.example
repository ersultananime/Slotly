# ============================================================
# Slotly — Environment Variables
# ============================================================
# Скопируй этот файл в .env.local и заполни своими данными из Supabase

# ------- Supabase -------
# Dashboard -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ------- Анализ сайта компании (только сервер, без NEXT_PUBLIC_) -------
GEMINI_API_KEY=
GEMINI_WEBSITE_MODEL=gemini-3.5-flash-lite

# ------- Prisma (через Supabase connection pooler) -------
# Dashboard -> Settings -> Database -> Connection string -> "Transaction" mode (порт 6543)
DATABASE_URL="postgresql://postgres.xxxx:password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# ------- Prisma (прямое подключение для миграций) -------
# Dashboard -> Settings -> Database -> Connection string -> "Session" mode (порт 5432)
DIRECT_URL="postgresql://postgres.xxxx:password@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"
